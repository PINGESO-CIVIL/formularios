{
  "name": "@pingeso-civil/formularios-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5140",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
