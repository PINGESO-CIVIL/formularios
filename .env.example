# Copia este archivo como .env y reemplaza cada valor replace-with-*.
# El archivo .env nunca se sube al repositorio.

# --- API ---
API_PORT=8080
API_ENV=dev
# Dentro de Docker Compose se usa el nombre del servicio (postgres), no localhost.
DATABASE_URL=postgres://formularios:replace-with-contrasena-postgres@postgres:5432/formularios?sslmode=disable
# JWKS del servicio usuarios-roles (puerto 5161 en tu máquina).
# Con este servicio en Docker y usuarios-roles en tu máquina se usa host.docker.internal.
AUTH_JWKS_URL=http://host.docker.internal:5161/.well-known/jwks.json
FRONTEND_URL=http://localhost:5140
TZ=America/Santiago

# --- PostgreSQL (solo para Docker Compose) ---
POSTGRES_USER=formularios
POSTGRES_PASSWORD=replace-with-contrasena-postgres
POSTGRES_DB=formularios
