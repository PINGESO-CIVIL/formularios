# Copia este archivo a .env y ajusta los valores. Usado por docker-compose y backend.

# --- Postgres ---
POSTGRES_USER=formularios
POSTGRES_PASSWORD=formularios
POSTGRES_DB=formularios
POSTGRES_PORT=5432

# --- MinIO (stub de archivos, fase 0) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend ---
APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=debug
DATABASE_URL=postgres://formularios:formularios@localhost:5432/formularios?sslmode=disable
DEV_JWT_SECRET=cambia-esto-solo-para-dev
FILESTORE=local
FILESTORE_LOCAL_DIR=./.data/files
EVENTS=log
